++)c[at+4+i]=32;c.set(a.subarray(at),at+4+n);return c;}\nasync function make(){if(!img)return;var s=spec(),msg='',out,o;\n if(mode()==='digital'){var d=s.digital;o=crop(d[0],d[1]);var max=(d[5]||1e5)*1024,min=d[4]*1024,lo=.3,hi=.96,best=null,b;\n  for(var n=0;n<8;n++){var q=(lo+hi)/2;b=await enc(o,q);if(b.size<=max){best=b;lo=q;}else hi=q;}if(!best)best=await enc(o,.3);\n  out=await dpi(best,300);if(out.length<min)out=pad(out,min-out.length+64);blob=new Blob([out],{type:'image/jpeg'});\n  $('pp-l1').textContent='Digital photo';$('pp-v1').textContent=d[0]+' x '+d[1]+' px';$('pp-l2').textContent='File size';$('pp-v2').textContent=(blob.size/1024).toFixed(0)+' KB';\n  var ok=blob.size<=max;msg=(ok?'<span class=\"pp-ok\">Ready to upload'+(d[5]?' (within the size limit)':'')+'.</span> ':'<span class=\"pp-bad\">Still over the size limit.</span> ')+bgCheck(o,s.bg);$('pp-dl').disabled=!ok;}\n else{var p=s.print,pw=Math.round(p[0]*MM),ph=Math.round(p[1]*MM);o=crop(pw,ph);\n  var fitN=function(g,SW,SH){return [g,Math.floor((SW+g)/(pw+g)),Math.floor((SH+g)/(ph+g)),SW,SH];},lay=[[1800,1200],[1200,1800]].reduce(function(acc,s){return acc.concat([fitN(Math.round(3*MM),s[0],s[1]),fitN(Math.round(MM),s[0],s[1]),fitN(0,s[0],s[1])]);},[]).reduce(function(a,b){return b[1]*b[2]>a[1]*a[2]?b:a;});  // most copies, widest gap, either way round\n  var SW=lay[3],SH=lay[4],sheet=document.createElement('canvas');sheet.width=SW;sheet.height=SH;var x=sheet.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,SW,SH);\n  var g=lay[0],cols=lay[1],rows=lay[2],mx=(SW-cols*pw-(cols-1)*g)/2,my=(SH-rows*ph-(rows-1)*g)/2;\n  x.strokeStyle='#b8bcc6';x.lineWidth=1;for(var r=0;r<rows;r++)for(var c=0;c<cols;c++){var X=Math.round(mx+c*(pw+g)),Y=Math.round(my+r*(ph+g));x.drawImage(o,X,Y);x.strokeRect(X-.5,Y-.5,pw+1,ph+1);}\n  if(my>=30){x.fillStyle='#8a8f9c';x.font='20px sans-serif';x.fillText('Print at 100% on 4 x 6 in (10 x 15 cm) paper. Cut on the grey lines. '+p[0]+' x '+p[1]+' mm.',mx,SH-Math.max(8,my/2-6));}\n  out=await dpi(await enc(sheet,.95),300);blob=new Blob([out],{type:'image/jpeg'});\n  $('pp-l1').textContent='On a 4 x 6 in sheet';$('pp-v1').textContent=cols*rows+' photos';$('pp-l2').textContent='Each photo';$('pp-v2').textContent=p[0]===50.8?'2 x 2 in':p[0]+' x '+p[1]+' mm';\n  msg='<span class=\"pp-ok\">Sheet ready.</span> Print it at actual size (100%, no \"fit to page\") at a photo kiosk or lab. '+bgCheck(o,s.bg);$('pp-dl').disabled=false;}\n if($('pp-out').src)URL.revokeObjectURL($('pp-out').src);$('pp-out').src=URL.createObjectURL(blob);$('pp-msg').innerHTML=msg;}\nasync function open(f){if(!f)return;var heic=/hei[cf]$/i.test(f.name)||/hei[cf]/.test(f.type);$('pp-msg').textContent='Opening\\u2026';\n var get=function(b){return new Promise(function(ok,no){var i=new Image();i.onload=function(){ok(i);};i.onerror=no;i.src=URL.createObjectURL(b);});};\n try{img=await get(f);}catch(e){if(!heic){$('pp-msg').textContent='This file could not be opened. Try a JPG or PNG.';return;}\n  try{if(!window.HeicTo)await load('https://cdn.jsdelivr.net/npm/heic-to@1.5.2/dist/iife/heic-to.js');img=await get(await HeicTo({blob:f,type:'image/jpeg',quality:.95}));}catch(e2){$('pp-msg').textContent='This HEIC photo could not be opened. Take a screenshot of it, or set your camera to \"Most compatible\".';return;}}\n rot=0;$('pp-drop').hidden=true;$('pp-work').hidden=false;fit();}\n$('pp-file').addEventListener('change',function(){open(this.files[0]);this.value='';});\n['dragover','dragenter'].forEach(function(t){$('pp-drop').addEventListener(t,function(e){e.preventDefault();this.classList.add('bt-over');});});\n$('pp-drop').addEventListener('dragleave',function(){this.classList.remove('bt-over');});\n$('pp-drop').addEventListener('drop',function(e){e.preventDefault();this.classList.remove('bt-over');open(e.dataTransfer.files[0]);});\n$('pp-doc').addEventListener('change',info);$('pp-mode').addEventListener('change',fit);\n['pp-cw','pp-ch','pp-chead','pp-cpx','pp-ckb'].forEach(function(i){$(i).addEventListener('input',info);});\n$('pp-zoom').addEventListener('input',function(){zoom=+this.value;draw();});\n$('pp-rot').addEventListener('click',function(){rot=(rot+1)%4;fit();});$('pp-fit').addEventListener('click',fit);\n$('pp-new').addEventListener('click',function(){img=null;blob=null;$('pp-work').hidden=true;$('pp-drop').hidden=false;$('pp-file').click();});\nvar drag=null;cv.addEventListener('pointerdown',function(e){if(!img)return;drag={x:e.clientX,y:e.clientY,ox:ox,oy:oy,k:cv.width/cv.getBoundingClientRect().width};cv.setPointerCapture(e.pointerId);});\ncv.addEventListener('pointermove',function(e){if(!drag)return;ox=drag.ox+(e.clientX-drag.x)*drag.k;oy=drag.oy+(e.clientY-drag.y)*drag.k;draw();});\ncv.addEventListener('pointerup',function(){drag=null;});cv.addEventListener('pointercancel',function(){drag=null;});\ncv.addEventListener('wheel',function(e){if(!img)return;e.preventDefault();zoom=Math.max(1,Math.min(5,zoom*(e.deltaY<0?1.08:.93)));$('pp-zoom').value=zoom;draw();},{passive:false});\n$('pp-dl').addEventListener('click',function(){if(!blob)return;var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=$('pp-doc').value+'-photo-'+(mode()==='print'?'4x6-sheet':'digital')+'.jpg';document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(a.href);a.remove();},1500);});\n// A guide page can choose the document: <div class=\"bd-pp-preset\" data-p=\"uk-passport\"></div>\nvar pre=document.querySelector('.bd-pp-preset');if(pre&&P[pre.dataset.p])$('pp-doc').value=pre.dataset.p;\ninfo();\n})();\n</script>\n</div>\n\n\n<h2>Canadian Passport Photo Requirements</h2>\n<table>\n<thead><tr><th>Rule</th><th>Printed photos</th><th>Digital (online renewal)</th></tr></thead>\n<tbody>\n<tr><td>Size</td><td>50 mm wide &times; 70 mm high</td><td>At least 1,200 &times; 1,800 px, at most 3,000 &times; 4,500 px (portrait, 2:3)</td></tr>\n<tr><td>Face</td><td>31&ndash;36 mm chin to crown</td><td>45&ndash;50% of the photo's height</td></tr>\n<tr><td>File</td><td>&mdash;</td><td>JPEG, 200 KB to 5 MB, saved straight from the camera (no scans)</td></tr>\n<tr><td>Background</td><td>Plain white or light-coloured</td><td>Plain white or light-coloured</td></tr>\n<tr><td>Age</td><td>Taken in the last 6 months</td><td>Taken in the last 6 months</td></tr>\n<tr><td>Copies and extras</td><td>2 identical photos; studio name, address and date on the back</td><td>Studio or photographer's name and address and the date, entered in the form</td></tr>\n</tbody>\n</table>\n\n<h2>Using the Tool for a Canadian Application</h2>\n<ol>\n<li><strong>Online renewal:</strong> choose \"A digital photo to upload\". The tool saves a 1,200 &times; 1,800 pixel JPEG within the file-size limits, with the head in the right range. Canada asks for the photographer's details, so ask whoever takes the photo to note their name and address.</li>\n<li><strong>Paper application:</strong> use a commercial photo studio, as the back of the photos must carry the studio's details. You can use the tool first to check that your hair, glasses and expression will pass.</li>\n</ol>\n\n<h2>Common Problems</h2>\n<ul>\n<li>Using the US or Schengen size by mistake: Canadian photos are 50 &times; 70 mm.</li>\n<li>Missing studio name, address or date on the back of printed photos.</li>\n<li>Scanned photos for online renewal: digital photos must be the original camera file.</li>\n<li>Shadows on the background or face, or glasses with glare.</li>\n</ul>\n\n<h2>Frequently Asked Questions</h2>\n<h3>What size is a Canadian passport photo?</h3>\n<p>50 mm wide by 70 mm high (about 2 &times; 2 3/4 inches), with the face 31&ndash;36 mm from chin to crown.</p>\n<h3>Can I print my own Canadian passport photos?</h3>\n<p>Not for a paper application: the photos must show the photo studio's name, address and the date on the back. For online renewal you upload a digital photo instead.</p>\n<h3>What are the digital photo requirements for online renewal?</h3>\n<p>A JPEG of at least 1,200 &times; 1,800 pixels (up to 3,000 &times; 4,500), 200 KB to 5 MB, with the face 45&ndash;50% of the height, taken in the last six months.</p>\n<h3>Is a Canadian visa photo the same size?</h3>\n<p>No. Canadian visa and permit applications usually use a 35 &times; 45 mm photo, like the Schengen size, and are often submitted digitally. Check your application's instructions.</p>\n\n<h2 id=\"sources\">Sources</h2>\n<ul class=\"bd-sources\">\n<li><a href=\"https://www.canada.ca/en/immigration-refugees-citizenship/services/canadian-passports/photos.html\" rel=\"noopener\" target=\"_blank\">Government of Canada: Canadian passport photos</a></li>\n</ul>\n\n<div class=\"bd-cite\" style=\"margin:1.6em 0;padding:14px 16px;border-radius:14px;border:1px solid rgba(120,120,140,.25);font:500 14px/1.55 system-ui,sans-serif\"><b>Cite this page:</b> Blog Digest, &ldquo;Canadian Passport Photo Size: 50x70 mm and Online Renewal Photo Rules (Free Maker)&rdquo;, updated 27 October 2026, https://randomthoughtsever.blogspot.com/2026/10/canadian-passport-photo-size-50x70-mm.html</div>\n<h2>Related Guides</h2>\n<ul>\n<li><a href=\"https://randomthoughtsever.blogspot.com/2026/10/free-passport-and-visa-photo-maker.html\">Free Passport and Visa Photo Maker: Exact Official Sizes for 8 Countries, Print or Upload</a></li>\n<li><a href=\"https://randomthoughtsever.blogspot.com/2026/10/us-passport-photo-size-and-rules-make.html\">US Passport Photo Size and Rules: Make a 2x2 Inch Photo Free at Home</a></li>\n<li><a href=\"https://randomthoughtsever.blogspot.com/2026/10/convert-heic-to-jpg-shrink-photos-and.html\">Convert HEIC to JPG, Shrink Photos and Remove Location Data, Without Uploading</a></li>\n<li><a href=\"https://randomthoughtsever.blogspot.com/2026/10/what-happens-to-your-retirement-savings.html\">What Happens to Your Retirement Savings When You Move Abroad?</a></li>\n</ul>\n<p><em>Requirements from the Government of Canada (IRCC), checked in October 2026.</em></p>\n\n<script type=\"application/ld+json\" id=\"bd-faq-ld\">{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"What size is a Canadian passport photo?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"50 mm wide by 70 mm high (about 2 \\u00D7 2 3/4 inches), with the face 31\\u201336 mm from chin to crown.\"}}, {\"@type\": \"Question\", \"name\": \"Can I print my own Canadian passport photos?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Not for a paper application: the photos must show the photo studio's name, address and the date on the back. For online renewal you upload a digital photo instead.\"}}, {\"@type\": \"Question\", \"name\": \"What are the digital photo requirements for online renewal?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"A JPEG of at least 1,200 \\u00D7 1,800 pixels (up to 3,000 \\u00D7 4,500), 200 KB to 5 MB, with the face 45\\u201350% of the height, taken in the last six months.\"}}, {\"@type\": \"Question\", \"name\": \"Is a Canadian visa photo the same size?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"No. Canadian visa and permit applications usually use a 35 \\u00D7 45 mm photo, like the Schengen size, and are often submitted digitally. Check your application's instructions.\"}}]}</script>\n</div>",
