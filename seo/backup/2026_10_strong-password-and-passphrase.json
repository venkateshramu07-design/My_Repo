womb wool woozy word work worry wound woven wrath wreck wrist xerox yahoo yam yard year yeast yelp yield yo-yo yodel yoga yoyo yummy zebra zero zesty zippy zone zoom\".split(' ');\nvar COMMON=['123456','password','123456789','12345678','12345','qwerty','abc123','password1','111111','iloveyou','admin','welcome','monkey','dragon','letmein','football','baseball','sunshine','princess','qwerty123','1q2w3e4r','000000','superman','starwars','trustno1','passw0rd','master','hello','freedom','whatever'];\nfunction rnd(n){var a=new Uint32Array(1),lim=Math.floor(4294967296/n)*n;do{crypto.getRandomValues(a);}while(a[0]>=lim);return a[0]%n;}\nfunction sets(){var amb=$('pw-amb').checked,s=[];if($('pw-u').checked)s.push(amb?'ABCDEFGHJKLMNPQRSTUVWXYZ':'ABCDEFGHIJKLMNOPQRSTUVWXYZ');if($('pw-l').checked)s.push(amb?'abcdefghijkmnopqrstuvwxyz':'abcdefghijklmnopqrstuvwxyz');\n if($('pw-d').checked)s.push(amb?'23456789':'0123456789');if($('pw-s').checked)s.push('!@#$%^&*-_=+?');return s;}\nfunction gen(){var out,bits;\n if(mode==='phrase'){var n=+$('pw-n').value,ws=[];for(var i=0;i<n;i++){var w=W[rnd(W.length)];ws.push($('pw-cap').checked?w[0].toUpperCase()+w.slice(1):w);}\n  bits=n*Math.log2(W.length);if($('pw-num').checked){var k=rnd(ws.length);ws[k]+=rnd(10);bits+=Math.log2(10*ws.length);}out=ws.join($('pw-sep').value);}\n else{var s=sets();if(!s.length){$('pw-u').checked=true;s=sets();}var all=s.join(''),len=+$('pw-len').value,c=s.map(function(x){return x[rnd(x.length)];});\n  while(c.length<len)c.push(all[rnd(all.length)]);for(var j=c.length-1;j>0;j--){var r=rnd(j+1),t=c[j];c[j]=c[r];c[r]=t;}out=c.join('');bits=len*Math.log2(all.length);}\n $('pw-out').textContent=out;show(bits,$('pw-str'),$('pw-time'),$('pw-bits'));}\nfunction crack(bits){var s=Math.pow(2,bits-1)/1e10;if(s<1)return 'instantly';var u=[['seconds',60],['minutes',60],['hours',24],['days',365],['years',1e3],['thousand years',1e3],['million years',1e3],['billion years',1e3]],v=s,i=0;while(i<u.length-1&&v>=u[i][1]){v/=u[i][1];i++;}return (v>=100?Math.round(v).toLocaleString():v.toFixed(v<10?1:0))+' '+u[i][0]+(i>=4&&v>=1e3?'+':'');}\nfunction label(bits){return bits<40?['Very weak','#c2341d']:bits<60?['Weak','#e48b12']:bits<80?['Good','#2f7de1']:bits<100?['Strong','#0f9d76']:['Very strong','#0f9d76'];}\nfunction show(bits,a,b,c){var l=label(bits);a.textContent=l[0];a.style.setProperty('color',l[1],'important');b.textContent=crack(bits);c.textContent=Math.round(bits)+' bits';}\nfunction estimate(p){if(!p)return 0;if(COMMON.indexOf(p.toLowerCase())>-1)return 5;var pool=0;if(/[a-z]/.test(p))pool+=26;if(/[A-Z]/.test(p))pool+=26;if(/\\d/.test(p))pool+=10;if(/[^a-zA-Z0-9]/.test(p))pool+=33;\n var b=p.length*Math.log2(pool||1);if(/(.)\\1{2,}/.test(p))b*=.7;if(/^[A-Za-z]+\\d{1,4}[!@#$.]?$/.test(p))b=Math.min(b,30+p.length);if(/(19|20)\\d\\d/.test(p))b-=8;if(/(abc|123|qwe|asd|password|admin)/i.test(p))b*=.6;return Math.max(1,b);}\n$('pw-test').oninput=function(){var p=this.value;if(!p){$('pw-tres').textContent='Typing here never leaves your device.';return;}var b=estimate(p),l=label(b);\n $('pw-tres').innerHTML='<b style=\"color:'+l[1]+'!important\">'+l[0]+'</b> \\u00B7 '+(crack(b)==='instantly'?'can be cracked instantly':'about '+crack(b)+' to crack')+(b<60?'. Use a passphrase of 6 or more random words instead.':'.')+(COMMON.indexOf(p.toLowerCase())>-1?' This is one of the most common passwords in the world.':'');};\n$('pw-hibp').onclick=async function(){var p=$('pw-test').value,o=$('pw-hres');if(!p){o.textContent='Type the password in the box above first.';return;}\n try{var h=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-1',new TextEncoder().encode(p)))).map(function(x){return x.toString(16).padStart(2,'0');}).join('').toUpperCase();\n  var r=await fetch('https://api.pwnedpasswords.com/range/'+h.slice(0,5),{headers:{'Add-Padding':'true'}}),t=await r.text(),m=t.split('\\n').map(function(l){return l.trim().split(':');}).filter(function(x){return x[0]===h.slice(5)&&+x[1]>0;})[0];\n  o.innerHTML=m?'<b style=\"color:#c2341d!important\">Found in '+(+m[1]).toLocaleString()+' breaches.</b> Stop using it everywhere and change it now.':'<b style=\"color:#0f9d76!important\">Not found</b> in known breaches. That is good, but it still needs to be long and unique to each site.';\n }catch(e){o.textContent='Could not reach the breach service. Check your connection.';}};\n$('pw-copy').onclick=function(){var b=this,t=$('pw-out').textContent;(navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(function(){b.textContent='Copied';setTimeout(function(){b.textContent='Copy';},1500);},function(){prompt('Copy this',t);});};\n$('pw-new').onclick=gen;\n$('pw-mode').onclick=function(e){var b=e.target.closest('button');if(!b)return;mode=b.dataset.m;[].forEach.call(this.children,function(x){x.classList.toggle('bt-on',x===b);});$('pw-phrase').hidden=mode!=='phrase';$('pw-pass').hidden=mode!=='pass';gen();};\n$('pw-len').oninput=function(){$('pw-lv').textContent=this.value;gen();};\nroot.addEventListener('change',function(e){if(e.target.id!=='pw-test')gen();});\ngen();\n})();\n</script>\n\n\n<h2>Passphrase or Random Password?</h2>\n<table>\n<thead><tr><th></th><th>Passphrase (6 random words)</th><th>Random password (20 characters)</th></tr></thead>\n<tbody>\n<tr><td>Example</td><td>Snout-Fend-Exact-Bath5-Slum-Acorn</td><td>!UmF9azP28dE$qH%BqFE</td></tr>\n<tr><td>Strength</td><td>About 68 bits: centuries to crack</td><td>About 123 bits: practically uncrackable</td></tr>\n<tr><td>Easy to type on a phone or TV</td><td>Yes</td><td>No</td></tr>\n<tr><td>Easy to remember</td><td>Yes, with a little practice</td><td>No: use a password manager</td></tr>\n<tr><td>Best for</td><td>Your password manager's master password, your phone, computer and main email</td><td>Every other account, saved in a password manager</td></tr>\n</tbody>\n</table>\n<p>The words come from the Electronic Frontier Foundation's list of 1,296 short, memorable words designed for this purpose. Each random word adds about 10 bits of strength, so the number of words matters more than how clever they are. Never choose the words yourself or use a famous quote; people are predictable, and attackers' word lists know it.</p>\n\n<h2>What Makes a Password Strong in 2026</h2>\n<ul>\n<li><strong>Length first.</strong> NIST's SP 800-63B (revision 4, 2025) sets a minimum of 15 characters for passwords used alone and tells websites to allow at least 64. Every extra character multiplies the work for an attacker.</li>\n<li><strong>Random, not clever.</strong> \"Summer2024!\" meets most old rules but falls in seconds, because attackers try words, years and a symbol at the end first. Test it in the checker to see.</li>\n<li><strong>One password per account.</strong> When one site is breached, criminals try the same email and password everywhere else (\"credential stuffing\"). A unique password limits the damage to that one site.</li>\n<li><strong>No forced changes.</strong> Current guidance says not to change passwords on a schedule, only when there is a sign one has been exposed, because forced changes lead to weaker, predictable passwords.</li>\n<li><strong>Turn on two-step verification</strong> for email, banking and social media. Even a stolen password is then not enough.</li>\n</ul>\n\n<h2>How the Breach Check Works (and Why It Is Safe)</h2>\n<p>\"Check if it appeared in a data breach\" uses the Pwned Passwords service run by security researcher Troy Hunt, which holds hundreds of millions of passwords leaked in real breaches. Your password is never sent. The tool scrambles it on your device into a SHA-1 fingerprint, sends only the first 5 of its 40 characters, receives a list of every leaked fingerprint starting with those 5 characters, and compares them on your device. This method, called k-anonymity, means the service can't tell which password you checked. If yours appears even once, stop using it everywhere.</p>\n\n<h2>Frequently Asked Questions</h2>\n<h3>Is it safe to use an online password generator?</h3>\n<p>It is safe when the password is created on your device, as this one is, using your browser's cryptographic random-number generator. Avoid generators that create passwords on their server.</p>\n<h3>How long should a password be?</h3>\n<p>At least 15 characters for a password that protects an account on its own, following NIST's 2025 guidance. A six-word passphrase or a 16&ndash;20 character random password is a good standard.</p>\n<h3>Are passphrases more secure than passwords?</h3>\n<p>A passphrase of six or more truly random words is about as strong as a 10-character random password, and much easier to remember and type. Random passwords stored in a password manager are stronger still.</p>\n<h3>How do I know if my password has been leaked?</h3>\n<p>Type it into the checker above and press the breach-check button. Only a partial, scrambled fingerprint is sent, so the password itself stays private. If it is found, change it on every site where you use it.</p>\n<h3>Do I still need a password manager?</h3>\n<p>Yes, for most people. Remember one strong passphrase for the manager, and let it generate and store a unique random password for every other account.</p>\n\n<h2 id=\"sources\">Sources</h2>\n<ul class=\"bd-sources\">\n<li><a href=\"https://csrc.nist.gov/pubs/sp/800/63/b/4/final\" rel=\"noopener\" target=\"_blank\">NIST SP 800-63B-4: Digital Identity Guidelines, authentication (2025)</a></li>\n<li><a href=\"https://www.eff.org/dice\" rel=\"noopener\" target=\"_blank\">Electronic Frontier Foundation: dice-generated passphrases and word lists</a></li>\n<li><a href=\"https://haveibeenpwned.com/Passwords\" rel=\"noopener\" target=\"_blank\">Have I Been Pwned: Pwned Passwords</a></li>\n<li><a href=\"https://www.ncsc.gov.uk/collection/top-tips-for-staying-secure-online/use-a-strong-and-separate-password-for-email\" rel=\"noopener\" target=\"_blank\">UK National Cyber Security Centre: use a strong and separate password for your email</a></li>\n</ul>\n\n<div class=\"bd-cite\" style=\"margin:1.6em 0;padding:14px 16px;border-radius:14px;border:1px solid rgba(120,120,140,.25);font:500 14px/1.55 system-ui,sans-serif\"><b>Cite this page:</b> Blog Digest, &ldquo;Strong Password and Passphrase Generator, Plus a Safe Breach Check&rdquo;, updated 25 October 2026, https://randomthoughtsever.blogspot.com/2026/10/strong-password-and-passphrase.html</div>\n<h2>Related Guides</h2>\n<ul>\n<li><a href=\"https://randomthoughtsever.blogspot.com/2026/10/what-happens-to-your-online-accounts.html\">What Happens to Your Online Accounts, Crypto and Money When You Die?</a></li>\n<li><a href=\"https://randomthoughtsever.blogspot.com/2026/10/what-happens-to-your-money-if-your-bank.html\">What Happens to Your Money If Your Bank or Fintech App Goes Bust?</a></li>\n<li><a href=\"https://randomthoughtsever.blogspot.com/2026/10/convert-heic-to-jpg-shrink-photos-and.html\">Convert HEIC to JPG, Shrink Photos and Remove Location Data, Without Uploading</a></li>\n<li><a href=\"https://randomthoughtsever.blogspot.com/2026/10/free-qr-code-generator-that-never.html\">Free QR Code Generator That Never Expires (No Sign-Up, No Trial)</a></li>\n<li><a href=\"https://randomthoughtsever.blogspot.com/2026/10/free-online-tools-that-dont-upload-your.html\">Free Online Tools That Don&#x27;t Upload Your Files, Make You Sign Up or Add Watermarks</a></li>\n</ul>\n<p><em>Crack times assume a fast offline attack of 10 billion guesses a second; real attacks on well-protected sites are much slower. Checked in October 2026.</em></p>\n\n<script type=\"application/ld+json\" id=\"bd-faq-ld\">{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Is it safe to use an online password generator?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"It is safe when the password is created on your device, as this one is, using your browser's cryptographic random-number generator. Avoid generators that create passwords on their server.\"}}, {\"@type\": \"Question\", \"name\": \"How long should a password be?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"At least 15 characters for a password that protects an account on its own, following NIST's 2025 guidance. A six-word passphrase or a 16\\u201320 character random password is a good standard.\"}}, {\"@type\": \"Question\", \"name\": \"Are passphrases more secure than passwords?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"A passphrase of six or more truly random words is about as strong as a 10-character random password, and much easier to remember and type. Random passwords stored in a password manager are stronger still.\"}}, {\"@type\": \"Question\", \"name\": \"How do I know if my password has been leaked?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Type it into the checker above and press the breach-check button. Only a partial, scrambled fingerprint is sent, so the password itself stays private. If it is found, change it on every site where you use it.\"}}, {\"@type\": \"Question\", \"name\": \"Do I still need a password manager?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Yes, for most people. Remember one strong passphrase for the manager, and let it generate and store a unique random password for every other account.\"}}]}</script>\n</div>",
