//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  DSG Simple: entry and exit signals only
//  Same engine as DSG Pro (Darvas Box + Stochastic Momentum Index +
//  GoNoGo-style Trend, auto-adapting to every timeframe), with all the
//  extra drawings removed. The chart shows just two things:
//     BUY  → enter at the close of that candle (label shows the stop-loss)
//     EXIT → close the trade
//  Optional: the trailing stop-loss line and a one-line status box.
//  Multi-timeframe panel: Trend, SMI, Darvas and signal status on up to
//  6 timeframes at once (default 5m, 15m, 1H, 4H, 1D, 1W) plus an overall
//  trend-alignment verdict. The chart timeframe's row is highlighted.
//
//  BUY  = close above a completed Darvas box  (Darvas rules, 5-bar confirm)
//       + SMI above its signal line and rising (Blau SMI 10,3,3,10 EMA)
//       + trend is Go                          (GoNoGo-style score ≥ +2)
//       + at least 2 of 4 quality checks: breakout volume, higher-timeframe
//         trend, near a new high, SMI not overbought
//  EXIT = price hits the trailing stop (just below the latest box bottom)
//       or (intraday) the trend turns NoGo
//  Tuned from a backtest of NIFTY, Bank NIFTY and 18 large caps:
//   • 5-bar box confirmation on every timeframe
//   • Daily+: no trend exit, the Darvas trailing stop lets winners run
//   • Intraday: breakout volume required; 30m and lower also need the
//     daily trend to be Go
//  Signals appear only when the candle closes (no repainting).
// ════════════════════════════════════════════════════════════════════════════
indicator("DSG Simple MTF: Buy / Exit", shorttitle = "DSG MTF", overlay = true, max_labels_count = 500)

// ───────────────────────── Inputs ─────────────────────────
grpM = "Multi-timeframe panel"
showMtf  = input.bool(true, "Show multi-timeframe panel", group = grpM)
mtfPos   = input.string("Bottom right", "Panel position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = grpM)
mtfSize  = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = grpM)
useTf1 = input.bool(true, "", inline = "t1", group = grpM)
tf1    = input.timeframe("5", "TF 1", inline = "t1", group = grpM)
useTf2 = input.bool(true, "", inline = "t2", group = grpM)
tf2    = input.timeframe("15", "TF 2", inline = "t2", group = grpM)
useTf3 = input.bool(true, "", inline = "t3", group = grpM)
tf3    = input.timeframe("60", "TF 3", inline = "t3", group = grpM)
useTf4 = input.bool(true, "", inline = "t4", group = grpM)
tf4    = input.timeframe("240", "TF 4", inline = "t4", group = grpM)
useTf5 = input.bool(true, "", inline = "t5", group = grpM)
tf5    = input.timeframe("D", "TF 5", inline = "t5", group = grpM)
useTf6 = input.bool(true, "", inline = "t6", group = grpM)
tf6    = input.timeframe("W", "TF 6", inline = "t6", group = grpM)

grpV = "Display"
showStop   = input.bool(true, "Show trailing stop-loss line", group = grpV)
showStatus = input.bool(true, "Show status box", group = grpV)
allowShort = input.bool(false, "Also show SELL (short) signals", group = grpV)

grpQ = "Signal quality"
minGrade    = input.string("B", "Signal strictness", options = ["A", "B", "C"], group = grpQ,
     tooltip = "A = strictest, fewest signals. B = balanced (default). C = most signals.")
exitMode    = input.string("Auto", "Exit when trend turns against the trade", options = ["Auto", "On", "Off"], group = grpQ,
     tooltip = "Auto = Off on daily/weekly/monthly (pure Darvas trailing stop lets winners run), On for intraday.")
volMode     = input.string("Auto", "Require breakout volume", options = ["Auto", "On", "Off"], group = grpQ,
     tooltip = "Auto = required on intraday charts, bonus check only on daily and above.")
dailyMode   = input.string("Auto", "Intraday: require daily trend Go", options = ["Auto", "On", "Off"], group = grpQ,
     tooltip = "Auto = required on 30m and lower charts: only buy intraday breakouts when the daily trend is Go.")
exitOnDiv   = input.bool(false, "Exit on opposite SMI divergence", group = grpQ)
sqOff       = input.bool(false, "Intraday: exit at session end", group = grpQ)

grpE = "Engine (advanced, leave as is)"
confirmBars  = input.int(5, "Darvas confirmation bars", minval = 1, maxval = 10, group = grpE)
minBoxAtr    = input.float(0.5, "Minimum box height (× ATR)", minval = 0, step = 0.1, group = grpE)
stopBufAtr   = input.float(0.2, "Stop buffer beyond box (× ATR)", minval = 0, step = 0.05, group = grpE)
volMult      = input.float(1.5, "Breakout volume ≥ × normal", minval = 0.5, step = 0.1, group = grpE)
volLen       = input.int(50, "Volume average length (D/W/M)", minval = 5, group = grpE)
volSess      = input.int(20, "Intraday: sessions for time-of-day volume", minval = 3, maxval = 100, group = grpE)
kLen         = input.int(10, "SMI %K periods", minval = 1, group = grpE)
kSmooth      = input.int(3, "SMI %K smoothing", minval = 1, group = grpE)
kDouble      = input.int(3, "SMI %K double smoothing", minval = 1, group = grpE)
dLen         = input.int(10, "SMI %D periods", minval = 1, group = grpE)
maType       = input.string("EMA", "SMI MA type", options = ["EMA", "SMA", "WMA", "RMA"], group = grpE)
obLevel      = input.float(40.0, "SMI overbought", group = grpE)
osLevel      = input.float(-40.0, "SMI oversold", group = grpE)
pivLen       = input.int(5, "Divergence pivot length", minval = 2, group = grpE)
emaFast      = input.int(13, "Trend fast EMA", group = grpE)
emaSlow      = input.int(21, "Trend slow EMA", group = grpE)
rsiLen       = input.int(14, "Trend RSI length", group = grpE)
diLen        = input.int(14, "Trend DMI / ADX length", group = grpE)
adxMin       = input.float(20.0, "Trend ADX threshold", group = grpE)
obvLen       = input.int(21, "Trend OBV EMA length", group = grpE)
goNeed       = input.int(2, "Trend score for Go / NoGo", minval = 1, maxval = 6, group = grpE)
trendConfirm = input.int(2, "Bars to confirm a trend change", minval = 1, maxval = 10, group = grpE)
htfIn        = input.timeframe("", "Higher timeframe (empty = auto)", group = grpE)
hiLenIn      = input.int(0, "New-high lookback, bars (0 = auto)", minval = 0, group = grpE)
intraDays    = input.int(20, "Intraday: new-high lookback in sessions", minval = 1, group = grpE)
nearIn       = input.float(0.0, "Within % of that high (0 = auto)", minval = 0, step = 0.5, group = grpE)
useAtrCap    = input.bool(false, "Cap initial risk with ATR", group = grpE)
atrCap       = input.float(3.0, "Max initial risk (× ATR)", minval = 0.5, step = 0.5, group = grpE)

// ───────────────────────── Timeframe profile ─────────────────────────
tfSec   = timeframe.in_seconds(timeframe.period)
isIntra = tfSec < 86400
autoHtf = tfSec <= 60 ? "5" : tfSec <= 180 ? "15" : tfSec <= 300 ? "30" : tfSec <= 900 ? "60" :
          tfSec <= 3600 ? "240" : tfSec <= 14400 ? "D" : tfSec <= 86400 ? "W" : tfSec <= 604800 ? "M" : "3M"
htfTf   = htfIn == "" ? autoHtf : htfIn
hiLen   = hiLenIn > 0 ? hiLenIn : tfSec <= 86400 ? 252 : tfSec <= 604800 ? 52 : 12
nearPct = nearIn > 0 ? nearIn : isIntra ? 3.0 : tfSec <= 86400 ? 10.0 : tfSec <= 604800 ? 15.0 : 25.0
refTf   = isIntra ? "D" : timeframe.period
useTrendExit = exitMode == "On" or (exitMode == "Auto" and isIntra)
useVolReq    = volMode == "On" or (volMode == "Auto" and isIntra)
useDaily     = isIntra and (dailyMode == "On" or (dailyMode == "Auto" and tfSec <= 1800))

// ───────────────────────── Helpers ─────────────────────────
type VolSlot
    array<float> v

ma(src, len) =>
    switch maType
        "SMA" => ta.sma(src, len)
        "WMA" => ta.wma(src, len)
        "RMA" => ta.rma(src, len)
        => ta.ema(src, len)

f_score() =>
    float eF = ta.ema(close, emaFast)
    float eS = ta.ema(close, emaSlow)
    [mLine, mSig, mHist] = ta.macd(close, 12, 26, 9)
    float r = ta.rsi(close, rsiLen)
    [dPlus, dMinus, adxV] = ta.dmi(diLen, diLen)
    float obvV = ta.cum(math.sign(ta.change(close)) * nz(volume))
    float obvE = ta.ema(obvV, obvLen)
    int s = 0
    s += close > eS ? 1 : -1
    s += eF > eS ? 1 : -1
    s += mHist > 0 ? 1 : -1
    s += r > 50 ? 1 : -1
    s += adxV >= adxMin ? (dPlus > dMinus ? 1 : -1) : 0
    s += nz(volume) > 0 ? (obvV > obvE ? 1 : -1) : 0
    s

fmt(x) => str.tostring(x, format.mintick)

// Compact copy of the signal engine, evaluated on each panel timeframe.
// Returns [trend, score, smi up?, Darvas state, in trade?, stop, event]
// event: 1 = BUY on this bar, -1 = EXIT on this bar, 0 = none
f_mtf() =>
    float a = ta.atr(14)
    var int   st = 0
    var float cT = na
    var int   tA = 0
    var float rM = na
    var int   mA = 0
    var float bT = na
    var float bB = na
    bool  done = false
    bool  up   = false
    float brB  = na
    if st == 2
        if close > bT
            up  := true
            brB := bB
            st  := 0
            cT  := na
        else if close < bB
            st := 0
            cT := na
    if st == 0
        if na(cT) or high > cT
            cT := high
            tA := 0
            rM := low
            mA := 0
        else
            tA += 1
            if low < rM
                rM := low
                mA := 0
            else
                mA += 1
            if tA >= confirmBars
                st := 1
    else if st == 1
        if high > cT
            st := 0
            cT := high
            tA := 0
            rM := low
            mA := 0
        else
            if low < rM
                rM := low
                mA := 0
            else
                mA += 1
            if mA >= confirmBars and (cT - rM) >= minBoxAtr * a
                st   := 2
                bT   := cT
                bB   := rM
                done := true
    float h2 = ta.highest(high, kLen)
    float l2 = ta.lowest(low, kLen)
    float n2 = ma(ma(close - (h2 + l2) / 2, kSmooth), kDouble)
    float d2 = ma(ma(h2 - l2, kSmooth), kDouble) / 2
    float s2 = d2 != 0 ? 100 * n2 / d2 : 0.0
    float g2 = ma(s2, dLen)
    bool smiUp = s2 > g2 and s2 >= s2[1]
    int sc  = f_score()
    int raw = sc >= goNeed ? 1 : sc <= -goNeed ? -1 : 0
    var int tr = 0
    var int pd = 0
    var int pN = 0
    if raw != tr
        if raw == pd
            pN += 1
        else
            pd := raw
            pN := 1
        if pN >= trendConfirm
            tr := raw
            pN := 0
    else
        pN := 0
    float vb  = ta.sma(nz(volume), 20)
    bool  vOK = not (vb > 0) or nz(volume) >= volMult * vb
    bool  intra = timeframe.in_seconds() < 86400
    var int   p  = 0
    var float sp = na
    int ev = 0
    if p == 1
        if done and bB - stopBufAtr * a > sp
            sp := bB - stopBufAtr * a
        if low <= sp or (intra and tr == -1)
            p  := 0
            ev := -1
    if p == 0 and up and smiUp and tr == 1 and (not intra or vOK)
        float s0 = brB - stopBufAtr * a
        if close > s0
            p  := 1
            sp := s0
            ev := 1
    [tr, sc, s2 > g2, st, p, sp, ev]

atr = ta.atr(14)

// ═════════════════════ 1. DARVAS BOX ═════════════════════
var int   dState  = 0
var float candTop = na
var int   topAge  = 0
var float runMin  = na
var int   minAge  = 0
var float boxTop  = na
var float boxBot  = na

bool  boxDone   = false
bool  darvasUp  = false
bool  darvasDn  = false
float brokenTop = na
float brokenBot = na

if dState == 2
    if close > boxTop
        darvasUp  := true
        brokenTop := boxTop
        brokenBot := boxBot
        dState    := 0
        candTop   := na
    else if close < boxBot
        darvasDn  := true
        brokenTop := boxTop
        brokenBot := boxBot
        dState    := 0
        candTop   := na

if dState == 0
    if na(candTop) or high > candTop
        candTop := high
        topAge  := 0
        runMin  := low
        minAge  := 0
    else
        topAge += 1
        if low < runMin
            runMin := low
            minAge := 0
        else
            minAge += 1
        if topAge >= confirmBars
            dState := 1
else if dState == 1
    if high > candTop
        dState  := 0
        candTop := high
        topAge  := 0
        runMin  := low
        minAge  := 0
    else
        if low < runMin
            runMin := low
            minAge := 0
        else
            minAge += 1
        if minAge >= confirmBars and (candTop - runMin) >= minBoxAtr * atr
            dState  := 2
            boxTop  := candTop
            boxBot  := runMin
            boxDone := true

// Volume: time-of-day relative volume intraday, moving average otherwise
var map<int, VolSlot> slots = map.new<int, VolSlot>()
float vol     = nz(volume)
float slotAvg = na
if isIntra
    int key = hour(time, syminfo.timezone) * 60 + minute(time, syminfo.timezone)
    VolSlot sl = slots.get(key)
    if na(sl)
        sl := VolSlot.new(array.new<float>())
        slots.put(key, sl)
    if sl.v.size() > 0
        slotAvg := sl.v.avg()
    if barstate.isconfirmed
        sl.v.push(vol)
        if sl.v.size() > volSess
            sl.v.shift()

smaVol   = ta.sma(vol, volLen)
volBase  = isIntra and not na(slotAvg) ? slotAvg : smaVol
hasVol   = volBase > 0
volRatio = hasVol ? vol / volBase : na
volOK    = not hasVol or volRatio >= volMult

// Near-new-high reference
dHi = request.security(syminfo.tickerid, refTf, ta.highest(high, intraDays)[1], lookahead = barmerge.lookahead_on)
dLo = request.security(syminfo.tickerid, refTf, ta.lowest(low, intraDays)[1], lookahead = barmerge.lookahead_on)
var float sessHi = na
var float sessLo = na
if timeframe.change("D")
    sessHi := high
    sessLo := low
else
    sessHi := math.max(nz(sessHi, high), high)
    sessLo := math.min(nz(sessLo, low), low)
barHi    = ta.highest(high, hiLen)
barLo    = ta.lowest(low, hiLen)
refHi    = isIntra ? math.max(nz(dHi, sessHi), sessHi) : barHi
refLo    = isIntra ? math.min(nz(dLo, sessLo), sessLo) : barLo
nearHigh = close >= refHi * (1 - nearPct / 100)
nearLow  = close <= refLo * (1 + nearPct / 100)

// ═════════════════════ 2. STOCHASTIC MOMENTUM INDEX ═════════════════════
hh     = ta.highest(high, kLen)
ll     = ta.lowest(low, kLen)
num    = ma(ma(close - (hh + ll) / 2, kSmooth), kDouble)
den    = ma(ma(hh - ll, kSmooth), kDouble) / 2
smi    = den != 0 ? 100 * num / den : 0.0
smiSig = ma(smi, dLen)

smiBull = smi > smiSig and smi >= smi[1]
smiBear = smi < smiSig and smi <= smi[1]

pl = ta.pivotlow(smi, pivLen, pivLen)
ph = ta.pivothigh(smi, pivLen, pivLen)
var float plSmi = na
var float plPx  = na
var float phSmi = na
var float phPx  = na
bool bullDiv = false
bool bearDiv = false
if not na(pl)
    float pxL = low[pivLen]
    if not na(plSmi) and pxL < plPx and pl > plSmi and pl < 0
        bullDiv := true
    plSmi := pl
    plPx  := pxL
if not na(ph)
    float pxH = high[pivLen]
    if not na(phSmi) and pxH > phPx and ph < phSmi and ph > 0
        bearDiv := true
    phSmi := ph
    phPx  := pxH

// ═════════════════════ 3. GONOGO-STYLE TREND ═════════════════════
score    = f_score()
rawTrend = score >= goNeed ? 1 : score <= -goNeed ? -1 : 0

var int trend = 0
var int pend  = 0
var int pendN = 0
if rawTrend != trend
    if rawTrend == pend
        pendN += 1
    else
        pend  := rawTrend
        pendN := 1
    if pendN >= trendConfirm
        trend := rawTrend
        pendN := 0
else
    pendN := 0

htfScore = request.security(syminfo.tickerid, htfTf, f_score()[1], lookahead = barmerge.lookahead_on)
htfValid = timeframe.in_seconds(htfTf) > tfSec
htfBull  = htfValid ? htfScore >= goNeed : trend == 1
htfBear  = htfValid ? htfScore <= -goNeed : trend == -1
dScore   = request.security(syminfo.tickerid, "D", f_score()[1], lookahead = barmerge.lookahead_on)
dailyBull = not useDaily or dScore >= goNeed
dailyBear = not useDaily or dScore <= -goNeed
volGate   = not useVolReq or volOK

// ═════════════════════ SIGNALS ═════════════════════
eodBar = sqOff and isIntra and session.islastbar
minNum = minGrade == "A" ? 3 : minGrade == "B" ? 2 : 1
extL   = (volOK ? 1 : 0) + (htfBull ? 1 : 0) + (nearHigh ? 1 : 0) + (smi < obLevel ? 1 : 0)
extS   = (volOK ? 1 : 0) + (htfBear ? 1 : 0) + (nearLow ? 1 : 0) + (smi > osLevel ? 1 : 0)
gradeL = extL >= 3 ? 3 : extL == 2 ? 2 : 1
gradeS = extS >= 3 ? 3 : extS == 2 ? 2 : 1

buySig  = barstate.isconfirmed and not eodBar and darvasUp and smiBull and trend == 1 and gradeL >= minNum and volGate and dailyBull
sellSig = barstate.isconfirmed and not eodBar and allowShort and darvasDn and smiBear and trend == -1 and gradeS >= minNum and volGate and dailyBear

// ═════════════════════ POSITION TRACKING ═════════════════════
var int   pos     = 0
var float entryPx = na
var float stopPx  = na
var float riskPx  = na

float exitR   = na
bool  didExit = false
bool  longIn  = false
bool  shortIn = false
float buf     = stopBufAtr * atr

if pos == 1
    if boxDone and boxBot - buf > stopPx
        stopPx := boxBot - buf
    float xPx = na
    if low <= stopPx
        xPx := math.min(open, stopPx)
    else if barstate.isconfirmed and (sellSig or (useTrendExit and trend == -1) or (exitOnDiv and bearDiv) or eodBar)
        xPx := close
    if not na(xPx)
        exitR   := (xPx - entryPx) / riskPx
        didExit := true
        pos     := 0
else if pos == -1
    if boxDone and boxTop + buf < stopPx
        stopPx := boxTop + buf
    float xPx = na
    if high >= stopPx
        xPx := math.max(open, stopPx)
    else if barstate.isconfirmed and (buySig or (useTrendExit and trend == 1) or (exitOnDiv and bullDiv) or eodBar)
        xPx := close
    if not na(xPx)
        exitR   := (entryPx - xPx) / riskPx
        didExit := true
        pos     := 0

if pos == 0 and buySig
    float s0 = brokenBot - buf
    float sl = useAtrCap ? math.max(s0, close - atrCap * atr) : s0
    if close - sl > 0
        pos     := 1
        entryPx := close
        stopPx  := sl
        riskPx  := close - sl
        longIn  := true
else if pos == 0 and sellSig
    float s0 = brokenTop + buf
    float sl = useAtrCap ? math.min(s0, close + atrCap * atr) : s0
    if sl - close > 0
        pos     := -1
        entryPx := close
        stopPx  := sl
        riskPx  := sl - close
        shortIn := true

// ═════════════════════ CHART: only BUY / SELL / EXIT ═════════════════════
if longIn
    label.new(bar_index, low, "BUY\nSL " + fmt(stopPx), style = label.style_label_up,
         color = color.new(color.green, 0), textcolor = color.white, size = size.normal)
if shortIn
    label.new(bar_index, high, "SELL\nSL " + fmt(stopPx), style = label.style_label_down,
         color = color.new(color.red, 0), textcolor = color.white, size = size.normal)
if didExit
    label.new(bar_index, exitR > 0 ? high : low, "EXIT",
         style = exitR > 0 ? label.style_label_down : label.style_label_up,
         color = color.new(exitR > 0 ? color.blue : color.gray, 0), textcolor = color.white, size = size.normal)

plot(showStop and pos != 0 ? stopPx : na, "Stop-loss", color.new(color.orange, 0), 2, plot.style_linebr)

var table status = table.new(position.top_right, 1, 1, bgcolor = color.new(color.black, 20))
if showStatus
    string sTxt = pos == 1 ? "IN BUY · Stop " + fmt(stopPx) : pos == -1 ? "IN SELL · Stop " + fmt(stopPx) : "WAIT · no trade"
    color  sCol = pos == 1 ? color.lime : pos == -1 ? color.red : color.silver
    table.cell(status, 0, 0, sTxt, text_color = sCol, text_size = size.normal)

// ═════════════════════ MULTI-TIMEFRAME PANEL ═════════════════════
[tr1, sc1, sm1, ds1, ps1, sp1, ev1] = request.security(syminfo.tickerid, tf1, f_mtf())
[tr2, sc2, sm2, ds2, ps2, sp2, ev2] = request.security(syminfo.tickerid, tf2, f_mtf())
[tr3, sc3, sm3, ds3, ps3, sp3, ev3] = request.security(syminfo.tickerid, tf3, f_mtf())
[tr4, sc4, sm4, ds4, ps4, sp4, ev4] = request.security(syminfo.tickerid, tf4, f_mtf())
[tr5, sc5, sm5, ds5, ps5, sp5, ev5] = request.security(syminfo.tickerid, tf5, f_mtf())
[tr6, sc6, sm6, ds6, ps6, sp6, ev6] = request.security(syminfo.tickerid, tf6, f_mtf())

mPos  = mtfPos == "Top right" ? position.top_right : mtfPos == "Top left" ? position.top_left : mtfPos == "Bottom left" ? position.bottom_left : position.bottom_right
mSize = mtfSize == "Tiny" ? size.tiny : mtfSize == "Normal" ? size.normal : size.small
var table mtf = table.new(mPos, 5, 8, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 70), border_width = 1)

tfName(t) => t == "D" or t == "1D" ? "1D" : t == "W" or t == "1W" ? "1W" : t == "M" or t == "1M" ? "1M" : timeframe.in_seconds(t) >= 3600 ? str.tostring(timeframe.in_seconds(t) / 3600) + "H" : t + "m"

mRow(r, on, t, tr, sc, sm, ds, ps, sp, ev) =>
    if on
        bool  isChart = timeframe.in_seconds(t) == tfSec
        color bg   = isChart ? color.new(color.blue, 70) : na
        color tCol = tr == 1 ? color.rgb(102, 204, 255) : tr == -1 ? color.rgb(255, 102, 178) : color.rgb(255, 191, 0)
        string tTxt = (tr == 1 ? "Go " : tr == -1 ? "NoGo " : "Neutral ") + str.tostring(sc)
        string dTxt = ds == 2 ? "Box" : ds == 1 ? "Forming" : "Seeking"
        string sTxt = ev == 1 ? "BUY" : ev == -1 ? "EXIT" : ps == 1 ? "IN · SL " + fmt(sp) : "WAIT"
        color  sCol = ev == 1 ? color.lime : ev == -1 ? color.orange : ps == 1 ? color.lime : color.silver
        table.cell(mtf, 0, r, tfName(t) + (isChart ? " ◀" : ""), text_color = color.white, text_size = mSize, bgcolor = bg, text_halign = text.align_left)
        table.cell(mtf, 1, r, tTxt, text_color = tCol, text_size = mSize, bgcolor = bg)
        table.cell(mtf, 2, r, sm ? "▲" : "▼", text_color = sm ? color.lime : color.red, text_size = mSize, bgcolor = bg)
        table.cell(mtf, 3, r, dTxt, text_color = ds == 2 ? color.white : color.gray, text_size = mSize, bgcolor = bg)
        table.cell(mtf, 4, r, sTxt, text_color = sCol, text_size = mSize, bgcolor = bg)
    else
        for c = 0 to 4
            table.cell(mtf, c, r, "", text_size = mSize)

if showMtf and barstate.isfirst
    table.merge_cells(mtf, 1, 7, 4, 7)
if showMtf and barstate.islast
    for [c, h] in array.from("TF", "Trend", "SMI", "Darvas", "Status")
        table.cell(mtf, c, 0, h, text_color = color.silver, text_size = mSize)
    mRow(1, useTf1, tf1, tr1, sc1, sm1, ds1, ps1, sp1, ev1)
    mRow(2, useTf2, tf2, tr2, sc2, sm2, ds2, ps2, sp2, ev2)
    mRow(3, useTf3, tf3, tr3, sc3, sm3, ds3, ps3, sp3, ev3)
    mRow(4, useTf4, tf4, tr4, sc4, sm4, ds4, ps4, sp4, ev4)
    mRow(5, useTf5, tf5, tr5, sc5, sm5, ds5, ps5, sp5, ev5)
    mRow(6, useTf6, tf6, tr6, sc6, sm6, ds6, ps6, sp6, ev6)
    int nOn = (useTf1 ? 1 : 0) + (useTf2 ? 1 : 0) + (useTf3 ? 1 : 0) + (useTf4 ? 1 : 0) + (useTf5 ? 1 : 0) + (useTf6 ? 1 : 0)
    int nGo = (useTf1 and tr1 == 1 ? 1 : 0) + (useTf2 and tr2 == 1 ? 1 : 0) + (useTf3 and tr3 == 1 ? 1 : 0) + (useTf4 and tr4 == 1 ? 1 : 0) + (useTf5 and tr5 == 1 ? 1 : 0) + (useTf6 and tr6 == 1 ? 1 : 0)
    int nNo = (useTf1 and tr1 == -1 ? 1 : 0) + (useTf2 and tr2 == -1 ? 1 : 0) + (useTf3 and tr3 == -1 ? 1 : 0) + (useTf4 and tr4 == -1 ? 1 : 0) + (useTf5 and tr5 == -1 ? 1 : 0) + (useTf6 and tr6 == -1 ? 1 : 0)
    string aTxt = nGo == nOn ? "ALL GO: trend aligned up" : nNo == nOn ? "ALL NOGO: stay out" : nGo > nNo ? "Mostly Go (" + str.tostring(nGo) + "/" + str.tostring(nOn) + ")" : nNo > nGo ? "Mostly NoGo (" + str.tostring(nNo) + "/" + str.tostring(nOn) + ")" : "Mixed"
    color  aCol = nGo == nOn ? color.lime : nNo == nOn ? color.red : nGo > nNo ? color.rgb(102, 204, 255) : nNo > nGo ? color.rgb(255, 102, 178) : color.yellow
    table.cell(mtf, 0, 7, "Alignment", text_color = color.silver, text_size = mSize, text_halign = text.align_left)
    table.cell(mtf, 1, 7, aTxt, text_color = aCol, text_size = mSize)

// ═════════════════════ ALERTS ═════════════════════
if longIn
    alert("BUY " + syminfo.ticker + " " + timeframe.period + " @ " + fmt(close) + " | SL " + fmt(stopPx), alert.freq_once_per_bar_close)
if shortIn
    alert("SELL " + syminfo.ticker + " " + timeframe.period + " @ " + fmt(close) + " | SL " + fmt(stopPx), alert.freq_once_per_bar_close)
if didExit
    alert("EXIT " + syminfo.ticker + " " + timeframe.period + " @ " + fmt(close), alert.freq_once_per_bar_close)

alertcondition(longIn, "Buy", "DSG Simple: BUY")
alertcondition(shortIn, "Sell", "DSG Simple: SELL")
alertcondition(didExit, "Exit", "DSG Simple: EXIT")
