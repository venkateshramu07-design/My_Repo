rules_version = '2';
// BatchMates security rules: signed-in users can browse schools and batches,
// but only members can read/post a batch's wall and nobody can edit other people's data.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isMember(groupId) {
      return exists(/databases/$(db)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    // Only allow a counter to move by exactly +1 / -1 and nothing else to change.
    function onlyCounterStep(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && (request.resource.data[field] == resource.data[field] + 1
            || request.resource.data[field] == resource.data[field] - 1);
    }
    function shortString(v, max) { return v is string && v.size() > 0 && v.size() <= max; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid);
      match /groups/{groupId} {
        allow read, write: if isMe(uid);
      }
    }

    match /schools/{schoolId} {
      allow read: if signedIn();
      allow create: if signedIn() && shortString(request.resource.data.name, 200);
      // Counters move by one; anyone signed in may add another name ("alias") alumni know the school by.
      allow update: if signedIn() && (
        onlyCounterStep('memberCount')
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aliases'])
            && request.resource.data.aliases is list
            && request.resource.data.aliases.size() <= 30
            && request.resource.data.aliases.hasAll(resource.data.get('aliases', [])))
        // Alumni correct what the institution is (school vs college, engineering vs arts…).
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind', 'collegeType'])
            && request.resource.data.kind in ['SCHOOL', 'COLLEGE'])
      );
    }

    // Invite codes double as the public invite preview (school, batch title, member count, first names),
    // so a friend sees who's waiting before signing in. Single-document reads only; no listing.
    match /codes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'schoolName', 'title', 'regionLabel', 'memberCount', 'faces']);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'faces'])
        && request.resource.data.faces.size() <= 500;
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberCount == 1
        && shortString(request.resource.data.section, 20);
      allow update: if signedIn() && (
        onlyCounterStep('memberCount')
        || (isMember(groupId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['whatsappLink'])
            && (request.resource.data.whatsappLink == null
                || request.resource.data.whatsappLink.matches('https://chat[.]whatsapp[.]com/[A-Za-z0-9]+')))
      );

      match /members/{uid} {
        allow read: if signedIn();
        allow create: if isMe(uid);
        allow delete: if isMe(uid);
        // Your own "where are you now" card and your share counter.
        allow update: if isMe(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['city', 'now', 'memory', 'invites', 'name', 'photoUrl']);
      }

      // Classmates someone remembers but who hasn't joined yet.
      match /missing/{id} {
        allow read: if signedIn() && isMember(groupId);
        allow create: if signedIn() && isMember(groupId)
          && request.resource.data.addedBy == request.auth.uid
          && shortString(request.resource.data.name, 80);
        allow update: if signedIn() && (
          // anyone in the batch can count an invite they sent
          (isMember(groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invited'])
            && request.resource.data.invited == resource.data.invited + 1)
          // the person who was missing marks themselves found
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['foundUid'])
            && request.resource.data.foundUid == request.auth.uid && resource.data.foundUid == null)
        );
        allow delete: if signedIn() && resource.data.addedBy == request.auth.uid;
      }

      // Reunion plan: members propose; each person may only change their own vote / RSVP; the organiser locks the date.
      match /meta/reunion {
        allow read: if signedIn() && isMember(groupId);
        allow create: if signedIn() && isMember(groupId) && request.resource.data.createdBy == request.auth.uid;
        allow update: if signedIn() && isMember(groupId) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
            && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid]))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvp'])
            && request.resource.data.rsvp.diff(resource.data.rsvp).affectedKeys().hasOnly([request.auth.uid]))
          || (resource.data.createdBy == request.auth.uid)
        );
      }

      match /messages/{messageId} {
        allow read: if signedIn() && isMember(groupId);
        allow create: if signedIn() && isMember(groupId)
          && request.resource.data.uid == request.auth.uid
          && shortString(request.resource.data.text, 1000);
        // Reactions: each member may only add/remove their own uid.
        allow update: if signedIn() && isMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
