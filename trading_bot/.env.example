# ---- Safety ----
# true = paper trading: nothing is sent to Groww, orders are only logged.
DRY_RUN=true
# Master switch. false = alerts are logged but never traded.
TRADING_ENABLED=true

# ---- Webhook ----
# Long random string. Chartink webhook URL = http://<server-ip>:8000/webhook/<WEBHOOK_SECRET>
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- Groww login (needed only when DRY_RUN=false) ----
# Option A (fully automatic): API key + TOTP secret from Groww's API settings page
GROWW_API_KEY=
GROWW_TOTP_SECRET=
# Option B: API key + API secret (Groww may ask you to approve once a day)
GROWW_API_SECRET=

# ---- Trade ----
# SELL = short sell on signal, buy back on exit. BUY = buy on signal, sell on exit.
SIDE=SELL
# Fixed number of shares per trade (like the 100 in your Groww order screen)
QUANTITY=100
# NSE or BSE
EXCHANGE=NSE

# ---- Timing (IST) ----
# New trades only for signals received in this window
ENTRY_START=11:00
ENTRY_END=15:00
# Any open trade is closed at this time, whatever the signal says
SQUARE_OFF_TIME=15:15
# Exit if Chartink hasn't sent the stock again within this many minutes.
# Set it to your alert frequency + 1 (e.g. alert every 5 min -> 6).
SIGNAL_TIMEOUT_MINUTES=6

# ---- Optional Telegram notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DB_PATH=data/trades.db
