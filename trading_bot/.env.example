# ---- Safety ----
# true = paper trading: nothing is sent to Groww, orders are only logged.
DRY_RUN=true
# Master switch. false = webhooks are received and logged but never traded.
TRADING_ENABLED=true

# ---- Webhook ----
# Long random string. Chartink webhook URL = http://<server-ip>:8000/webhook/<WEBHOOK_SECRET>
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- Groww login (needed only when DRY_RUN=false) ----
# Option A (fully automatic): API key + TOTP secret from Groww's API settings page
GROWW_API_KEY=
GROWW_TOTP_SECRET=
# Option B: API key + API secret (Groww may ask you to approve once a day)
GROWW_API_SECRET=

# ---- Strategy / risk ----
# BUY for bullish scans, SELL for bearish (short) scans. Can be overridden per alert with ?side=SELL
DEFAULT_SIDE=BUY
CAPITAL_PER_TRADE=10000
STOP_LOSS_PCT=1.0
TARGET_PCT=2.0
# Worst-case daily loss is roughly MAX_TRADES_PER_DAY x CAPITAL_PER_TRADE x STOP_LOSS_PCT/100 (plus slippage)
MAX_TRADES_PER_DAY=5
MAX_PRICE=5000
MIN_PRICE=20
# Times are IST
ENTRY_START=09:20
ENTRY_END=14:45
SQUARE_OFF_TIME=15:05

# ---- Optional Telegram notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DB_PATH=data/trades.db
