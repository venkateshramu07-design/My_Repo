# ---- Groww credentials (TOTP flow: token never needs manual daily approval) ----
GROWW_API_KEY=your_totp_api_key
GROWW_TOTP_SECRET=your_totp_secret
# Alternatively use the approval flow instead of TOTP:
# GROWW_API_SECRET=your_api_secret

# ---- Webhook security: Chartink must call /webhook/chartink?token=<this> ----
WEBHOOK_TOKEN=change-me-to-a-long-random-string

# ---- Safety: true = paper trading (no real orders). Set false only after testing. ----
DRY_RUN=true

# ---- Order settings ----
PRODUCT=MTF                 # MTF | CNC | MIS
SIZING_MODE=fixed_qty       # fixed_qty | capital
QUANTITY=25                 # shares per signal (fixed_qty mode)
CAPITAL_PER_TRADE=10000     # your own money per trade (capital mode)
LEVERAGE=3.05               # capital mode: qty = floor(capital * leverage / price)
ENTRY_LIMIT_BUFFER_PCT=0.5  # buy LIMIT at LTP + 0.5% so it fills immediately
TARGET_PROFIT_PCT=7         # exit when profit > 7% of total order value

# ---- Risk limits ----
MAX_OPEN_TRADES=10
MAX_NEW_TRADES_PER_DAY=10
MAX_ORDER_VALUE=50000       # skip any single buy worth more than this (Rs)
ALLOW_REENTRY_SAME_DAY=false

# ---- Timing (IST) ----
ENTRY_START=09:20
ENTRY_END=15:15
POLL_SECONDS=5

DB_PATH=trades.db
