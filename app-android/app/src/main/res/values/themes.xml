<resources>
    <style name="Theme.Plainly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Plainly.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/page</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Plainly</item>
    </style>
</resources>
